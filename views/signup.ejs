<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;800&display=swap">
    <link rel="stylesheet" href="/styles.css">
    <title>Sign up</title>
</head>
<body>
    <form action="/signup" method="POST">
        <div class="lgo">
            <img src="/logo.jpg" alt="Ivan Vazov Austin Bulgarian School logo">
        </div>

        <h1>Create account</h1>
        <p class="mute">Ivan Vazov Austin Bulgarian School</p>

        <label for="name">Full name</label>
        <input type="text" id="name" name="name" maxlength="100" required>

        <label for="username">Username</label>
        <input type="text" id="username" name="username" maxlength="50" autocomplete="username" required>

        <label for="password">Password</label>
        <input type="password" id="password" name="password" minlength="8" autocomplete="new-password" required>

        <button type="submit">Sign up</button>

        <p class="signup">Already have an account? <a href="/">Log in</a></p>
    </form>
</body>
</html>